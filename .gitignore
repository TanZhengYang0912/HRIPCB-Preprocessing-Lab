# Python caches and build artefacts
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments and local configuration
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Test, coverage and notebook caches
.pytest_cache/
.cache/
*.coverage
htmlcov/
.ipynb_checkpoints/
*.ipynb

# macOS and editor files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Local logs and temporary files
*.log
*.tmp
tmp/
artifacts/

# HRIPCB dataset images and generated label caches.
# Keep the small YAML metadata files; obtain the image splits locally.
HRIPCB_UPDATE/train/
HRIPCB_UPDATE/val/
HRIPCB_UPDATE/test/
HRIPCB_UPDATE/**/*.cache

# Pretrained and locally trained model weights.
# The shared baseline checkpoint is already tracked, so this exception
# prevents accidental ignoring if it is regenerated in a fresh checkout.
*.pt
!runs/
!runs/baseline/
!runs/baseline/weights/
!runs/baseline/weights/best.pt

# Everything under runs/ is generated locally. Existing tracked files remain
# tracked, but new checkpoints, graphs, previews, videos, reports, sweep
# variants and copied datasets will not be added accidentally.
runs/**
!runs/baseline/
!runs/baseline/weights/
!runs/baseline/weights/best.pt

# Explicitly document common generated output names for readability.
runs/**/last.pt
runs/**/variants/
runs/**/previews/
runs/**/images/
runs/**/labels/
runs/**/*.png
runs/**/*.jpg
runs/**/*.jpeg
runs/**/*.mp4
runs/**/*.mov
runs/**/*.avi
runs/**/*.pdf

# Streamlit local state
.streamlit/
